# Ignore the following directories and files that are generated by Unity and shouldn't be tracked by Git
/Library/
/Temp/
/Obj/
/Logs/
/Build/

# Ignore IDE-specific files
.vs/
.idea/

# Ignore system-specific files
.DS_Store
Thumbs.db

# Ignore build files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Ignore Unity's auto-generated plugin files
*.apk
*.aab
*.app
*.xcodeproj
